#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "tap-unless-interrupted";
    quick-tap-ms = <180>;
};

&lt {
    flavor = "tap-unless-interrupted";
    quick-tap-ms = <180>;
};

/ {
    combos {
        compatible = "zmk,combos";
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;

        flavor = "tap-unless-interrupted";
        tapping-term-ms = <180>;
    };
};
               
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P    &kp BACKSPACE    &kp LEFT_GUI    &mt LEFT_CONTROL A
                &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L    &kp SEMICOLON    &kp RETURN    &lt 3 F10    &mt LEFT_SHIFT Z    &kp X    &kp C
                &kp V    &kp B    &kp ESCAPE    &kp DELETE    &kp N    &kp M    &kp COMMA    &kp PERIOD    &mt RIGHT_SHIFT SLASH    &lt 3 INT1    &mt LEFT_ALT INT5    &lt 1 SPACE    &kp LEFT_CONTROL    &mt LEFT_CONTROL MINUS
                &mo 2    &lt 2 INT4
            >;
        };
        layer_1 {
            bindings = <
                &kp 168230934    &kp F12    &kp F2    &kp F3    &kp F4    &kp F5    &kp F10    &kp F6    &kp F7    &kp F8    &kp F9    &kp BACKSLASH    &kp LEFT_GUI    &kp N1
                &kp N2    &kp N3    &kp N4    &kp N5    &kp N0    &kp N6    &kp N7    &kp N8    &kp N9    &kp SQT    &kp LEFT_CONTROL    &kp LEFT_SHIFT    &kp F11    &none
                &none    &none    &kp 67567677    &none    &kp LEFT_BRACKET    &kp 34013221    &kp 34013222    &kp RIGHT_BRACKET    &mt RIGHT_SHIFT NON_US_HASH    &none    &kp LEFT_ALT    &none    &kp LEFT_CONTROL    &mt LEFT_CONTROL EQUAL
                &none    &none
            >;
        };
        layer_2 {
            bindings = <
                &none    &none    &none    &none    &none    &none    &none    &kp HOME    &kp UP    &kp END    &none    &none    &kp LEFT_GUI    &kp LEFT_CONTROL
                &none    &none    &none    &none    &kp 17236043    &kp LEFT    &kp RIGHT    &none    &kp 67567696    &none    &none    &kp LEFT_SHIFT    &none    &none
                &none    &none    &none    &none    &kp 17236046    &kp DOWN    &none    &none    &kp 67567695    &none    &kp LEFT_ALT    &none    &kp LEFT_CONTROL    &none
                &none    &none
            >;
        };
        layer_3 {
            bindings = <
                &none    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_CLR    &none    &none    &none    &none    &none    &none    &none    &none
                &none    &kp C_BRI_DN    &kp C_BRI_UP    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &kp C_VOLUME_DOWN
                &kp C_VOLUME_UP    &none    &studio_unlock    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
                &none    &none
            >;
        };
    };
};
